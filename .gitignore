# Local test artifacts
*.tsbuildinfo
# Vite reads vite.config.(js|mjs|ts) in that order, so a type-check build
# that emitted vite.config.js would shadow the .ts source on the next run.
vite.config.js
vite.config.d.ts
backend/tables.txt
backend/test-*.txt

# Security policy: live credentials live ONLY in gitignored env files
# (backend/.env is excluded above; .env.example keeps dummy placeholders).
# Never commit passwords or API keys in READMEs, docs, or fixture files.
# backend/test-users.md carried a plaintext demo password in repo history;
# any recreated copy is ignored here so it cannot be staged again.
backend/test-users.md
