# Backend Configuration
PORT=8000

# PostgreSQL Database (Prisma) - PROVISION FIRST THEN SET
# Options:
#   Prisma Postgres:  prisma://... (run: npx prisma init --db)
#   Neon:             postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname
#   Supabase:         postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#   Local:            postgresql://postgres:password@localhost:5432/attendance_db
# Migrations and seeding connect here as the owner role (attendpro_owner).
DATABASE_URL=""

# Runtime connection as attendpro_app, subject to Row Level Security (M1-ARCHITECTURE.md §3.1).
# Leave blank to reuse DATABASE_URL until the two-role split is provisioned.
DATABASE_URL_APP=

# Local test database (option B1: ServBay PostgreSQL 16 on localhost).
# tests/dbGuard.ts verifies the EXACT host and database name below; a `_test`
# suffix alone is not accepted. tests/setup.ts refuses to run without these.
# Fake data only: real employee data is never copied into the test database.
TEST_DATABASE_URL=
TEST_DB_HOST=localhost
TEST_DB_NAME=attendpro_test

# Host of the hosted development database. The seed refuses to run unless
# DATABASE_URL points at this host, and the guard refuses to run if the test
# URL resolves to it.
DEV_DB_HOST=pooled.db.prisma.io

# Tests can only be reset when the operator also sets TEST_DB_ALLOW_RESET=yes.
# Leave unset so `npm run test:db:reset` stays disabled by default.
# TEST_DB_ALLOW_RESET=yes

# JWT Secret - GENERATE ONE: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ROTATE THIS IN PRODUCTION - never commit the real value
JWT_SECRET=

# Kiosk and QR keys. Each is a server-side HMAC key; the stored value is a
# keyed hash, never the raw token or PIN. Generate each like JWT_SECRET.
# Unset keys fail closed.
PIN_HMAC_KEY=
QR_SECRET_KEY=
KIOSK_PAIRING_KEY=
KIOSK_TOKEN_KEY=

# Service token for the auto-clock-out trigger (POST /api/jobs/auto-clock-out/run).
# Unset answers 401 to every caller.
JOB_TOKEN=

# CORS Allowed Origin (optional, defaults to localhost)
CORS_ORIGIN=http://localhost:5173

# Seed accounts (for `npm run db:seed`), used against the development database only.
# Passwords come from here and are never hardcoded or committed. Read from
# backend/.env, which is gitignored.
SUPERADMIN_PASSWORD=
HR_PASSWORD=
# Optional: point the seed at different development identities.
# SEED_SUPERADMIN_EMAIL=superadmin@attendpro.com
# SEED_HR_EMAIL=hr@attendpro.com
# Optional: business timezone for the seeded development business; defaults to UTC.
SEED_BUSINESS_TIMEZONE=UTC
# Required acknowledgement before the seed will write to the development database.
SEED_CONFIRM=

# ── Production bootstrap (backend/scripts/bootstrap.ts) ──────────────────
# One-time, owner-run: npm run db:bootstrap
# Refuses a test database, the development host, or a non-empty database
# unless --force is passed. Every password is validated by the API policy and
# never printed. Accounts must change their password on first sign-in.
BOOTSTRAP_CONFIRM=
BOOTSTRAP_BUSINESS_NAME=AttendPro
BOOTSTRAP_BUSINESS_SLUG=attendpro
BOOTSTRAP_BUSINESS_TIMEZONE=UTC
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_CODE=EMP-0001
# Optional second account for the pilot.
BOOTSTRAP_HR_EMAIL=
BOOTSTRAP_HR_PASSWORD=
BOOTSTRAP_HR_CODE=EMP-0002

# Optional dev-URL snapshot for the test guard. tests/setup.ts sets it in-process;
# you normally do not need it here.
# DEV_DATABASE_URL=

# Optional: Prisma Postgres (if using Prisma Data Platform)
# PRISMA_API_KEY=