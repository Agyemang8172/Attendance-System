# ── Frontend (Vite / React) ─────────────────────────────────────────────
# The base URL for the backend API
VITE_API_URL=http://localhost:8000/api

# ── Backend (Express API) ───────────────────────────────────────────────
PORT=8000

# PostgreSQL connection string used by Prisma.
# Local dev:  npx prisma dev   (prints a localhost connection string)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Server key for kiosk PIN storage: PINs are stored as
# HMAC-SHA-256(PIN_HMAC_KEY, employeeId || pin || salt). Generate like JWT_SECRET.
# The PIN reset endpoint refuses to run without this key (fails closed).
PIN_HMAC_KEY=replace_with_a_long_random_secret

# Server key for QR badge tokens: only HMAC-SHA-256(QR_SECRET_KEY, token) is
# stored, never the raw badge token. Generate like JWT_SECRET.
# The badge issue endpoint refuses to run without this key (fails closed).
QR_SECRET_KEY=replace_with_a_long_random_secret

# Server key for kiosk pairing codes: only HMAC-SHA-256(KIOSK_PAIRING_KEY,
# code) is stored, never the code itself (kiosk pairing is a 10-minute,
# single-use secret). Generate like JWT_SECRET. The pairing endpoints
# refuse to run without this key (fails closed).
KIOSK_PAIRING_KEY=replace_with_a_long_random_secret

# Server key for kiosk device tokens: the kiosk token (a JWT) is stored only
# as HMAC-SHA-256(KIOSK_TOKEN_KEY, token), so a database leak yields no usable
# device credential. Generate like JWT_SECRET. The kiosk middleware refuses
# to authenticate without this key (fails closed).
KIOSK_TOKEN_KEY=replace_with_a_long_random_secret

# Service token for the background job caller (contracts §9): the bearer on
# POST /api/jobs/auto-clock-out/run is compared against this value in constant
# time. Generate like JWT_SECRET.
# This is not a schedule in itself — an external scheduler (Windows Task
# Scheduler / cron) calls the route. The run route refuses to serve without
# it (fails closed): an unset JOB_TOKEN answers 401 to every caller.
JOB_TOKEN=replace_with_a_long_random_secret

# Browser origin allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Test Database ─────────────────────────────────────────────────────────
# Local test database (ServBay PostgreSQL 16). tests/dbGuard.ts verifies the
# exact host and name below; a `_test` suffix alone is not accepted.
TEST_DATABASE_URL=
TEST_DB_HOST=localhost
TEST_DB_NAME=attendpro_test

# Host of the hosted development database. The seed refuses to run unless
# DATABASE_URL points here, and the guard refuses if the test URL resolves to it.
DEV_DB_HOST=pooled.db.prisma.io

# Optional snapshot of the development URL. tests/setup.ts sets it in-process so
# a later file can still compare against the dev target; verify-auth.ts uses it.
# Do not point this at the test database.
DEV_DATABASE_URL=

# `npm run test:db:reset` stays disabled unless this is exactly "yes". It drops
# and rebuilds the verified test database, so leave it empty for normal runs.
TEST_DB_ALLOW_RESET=

# ── Seed credentials (prisma/seed.ts) ───────────────────────────────────
# Used only by `npm run db:seed` against the development database. Never put
# real credentials here. The seed creates one development business and a
# SUPERADMIN and HR account; passwords come from these variables.
SUPERADMIN_PASSWORD=replace_with_superadmin_password
HR_PASSWORD=replace_with_hr_password
SEED_SUPERADMIN_EMAIL=superadmin@attendpro.com
SEED_HR_EMAIL=hr@attendpro.com
SEED_BUSINESS_TIMEZONE=UTC
# Required acknowledgement before the seed writes to the development database.
SEED_CONFIRM=

# ── Production bootstrap (backend/scripts/bootstrap.ts) ──────────────────
# One-time, owner-run: npm run db:bootstrap
# Refuses a test database, the development host, or a non-empty database
# unless --force is passed. Passwords are never printed.
BOOTSTRAP_CONFIRM=
BOOTSTRAP_BUSINESS_NAME=AttendPro
BOOTSTRAP_BUSINESS_SLUG=attendpro
BOOTSTRAP_BUSINESS_TIMEZONE=UTC
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_CODE=EMP-0001
BOOTSTRAP_HR_EMAIL=
BOOTSTRAP_HR_PASSWORD=
BOOTSTRAP_HR_CODE=EMP-0002

# Restricted application database connection; replace placeholders locally.
DATABASE_URL_APP=postgresql://APP_USER:APP_PASSWORD@localhost:5432/attendpro?schema=public
