# ── Frontend (Vite / React) ─────────────────────────────────────────────
# The base URL for the backend API
VITE_API_URL=http://localhost:8000/api

# ── Backend (Express API) ───────────────────────────────────────────────
PORT=8000

# PostgreSQL connection string used by Prisma.
# Local dev:  npx prisma dev   (prints a localhost connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/attendance_db

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Browser origin allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Seed credentials (prisma/seed.ts) ───────────────────────────────────
# Used only by `npx tsx prisma/seed.ts`. Never put real credentials here.
SUPERADMIN_PASSWORD=replace_with_superadmin_password
HR_PASSWORD=replace_with_hr_password
STAFF_PASSWORD=replace_with_staff_password
